{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poc-sheet-generator",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "poc-sheet.3027apps.prusikmedia.com",
      "custom_domain": true
    },
    {
      "pattern": "3027apps.prusikmedia.com/poc-sheet*",
      "zone_name": "prusikmedia.com"
    },
    {
      "pattern": "3027apps.prusikmedia.com/poc-sheet-generator*",
      "zone_name": "prusikmedia.com"
    }
  ],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [
    {
      "binding": "AUTH_SERVICE",
      "service": "celeb-sheet-api",
      "remote": true
    }
  ],
  "vars": {
    "AUTH_PUBLIC_BASE": "https://celeb-sheet-api.prusikmedia.com",
    "AUTH_APP_KEY": "poc-sheet-generator"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
